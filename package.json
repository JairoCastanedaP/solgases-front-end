{
  "name": "solgases",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build && node scripts/generate-seo-files.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "test:watch": "ng test",
    "check:assets": "node scripts/check-assets.mjs",
    "verify": "npm run check:assets && npm run test && npm run build",
    "php:serve": "php -S localhost:8000",
    "optimize:images": "node scripts/optimize-images.mjs",
    "optimize:fonts": "node scripts/optimize-fonts.mjs"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  },
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/platform-server": "^22.2.4",
    "@angular/router": "^22.2.0",
    "@angular/ssr": "^22.2.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.1",
    "sharp": "^0.35.5",
    "subset-font": "^2.9.0",
    "typescript": "~6.0.2",
    "vitest": "^5.0.0"
  }
}
